# IBM watsonx.ai credentials (required for real Granite insights)
# Leave blank to use the built-in mock fallback.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional: override the Granite model ID
# WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Optional: FastAPI host/port (used when running src/api.py directly)
API_HOST=0.0.0.0
API_PORT=8000
